struct func {
    int k;
    int b;
    func(int k = 0, int b = 0) {
        this->k = k;
        this->b = b;
    }
    int val(int x) {
        return k * x + b;
    }
};
 
func tree[Ts];
int vb[N];
 
void build() {
    for (int i = 0; i < Ts; i++) tree[i] = func(0, INF);
}
 
void add(func& f, int x, int lx, int rx) {
    int mid = (lx + rx) / 2;
    if (f.val(vb[mid]) < tree[x].val(vb[mid])) swap(f, tree[x]);
    if (rx - lx == 1) return;
    if (f.val(lx) < tree[x].val(lx)) add(f, 2 * x + 1, lx, mid);
    else add(f, 2 * x + 2, mid, rx);
}
 
int get(int pos, int x, int lx, int rx) {
    int ans = tree[x].val(vb[pos]);
    if (rx - lx == 1) return ans;
    int mid = (lx + rx) / 2;
    if (pos < mid) return min(ans, get(pos, 2 * x + 1, lx, mid));
    else return min(ans, get(pos, 2 * x + 2, mid, rx));
}
