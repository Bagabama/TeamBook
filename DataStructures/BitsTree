//Реалтзация, считающая сумму на префиксе до позиции pos включительно
//И поддерживающее прибавление (не замену) в точке
//Можно легко переделать в максимум / минимум на отрезке

int tree[Ts];

void add(int pos, int val) {
    for (; pos < Ts; pos |= (pos + 1)) tree[pos] += val;
}

int mx(int pos) {
    int ret = 0;
    for (; pos >= 0; pos = (pos & (pos + 1)) - 1) ret += tree[pos];
    return ret;
}
